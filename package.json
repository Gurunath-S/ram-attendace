{
  "name": "ad-garments-attendance",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "npm run dev --workspace=@ad-garments/api",
    "backend:dev": "npm run dev --workspace=@ad-garments/api",
    "migrate": "npm run migrate --workspace=@ad-garments/api",
    "db:init": "npm run db:init --workspace=@ad-garments/api",
    "frontend:dev": "npm run web --workspace=@ad-garments/mobile",
    "frontend:start": "npm run start --workspace=@ad-garments/mobile",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace=@ad-garments/domain && npm run build --workspace=@ad-garments/api",
    "eas-build-post-install": "npm run build --workspace=@ad-garments/domain",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
